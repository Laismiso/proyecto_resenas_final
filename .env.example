# Copia este archivo como .env y completa tus valores locales.
# .env contiene la contraseña real y no se sube al repositorio.
# Este archivo de ejemplo sí se sube: sirve para saber qué variables hacen falta.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Conexión de PostgreSQL local.
# Cambia CAMBIA_ESTA_CLAVE por la contraseña que asignaste al rol admin_app.
DATABASE_URL=postgresql://admin_app:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/restaurant_reviews

# Cookie segura en producción con HTTPS. En desarrollo local debe ser false.
COOKIE_SECURE=false
SESSION_DAYS=7

# Dirección que se usa para armar los enlaces de recuperación.
APP_URL=http://127.0.0.1:3000
RECOVERY_MINUTES=60

# Correo saliente para recuperar contraseñas (opcional en desarrollo).
# Sin SMTP_HOST, el enlace se muestra en la consola del servidor.
# En producción sí es necesario configurarlo para que la recuperación funcione.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sabor & Reseña <no-reply@example.com>
